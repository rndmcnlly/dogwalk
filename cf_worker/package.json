{
  "name": "dogwalk-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute dogwalk --file=schema.sql",
    "db:init:remote": "wrangler d1 execute dogwalk --remote --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260718.1",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.112.0"
  },
  "dependencies": {
    "jose": "^6.2.3"
  }
}
